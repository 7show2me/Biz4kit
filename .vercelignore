# Local env files must never ship in deployments: Vercel project env vars are
# the source of truth (pnpm env:preview, pnpm env:production), and frameworks like Next.js would
# otherwise load these localhost values at runtime.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.schema
local.db
local.db-*
.alchemy/
