# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# Polar billing waits for Phase 2 (D98, WBS 5.5). Empty turns the plugin off.
# @required=false @type=string(minLength=1)
POLAR_ACCESS_TOKEN=

# @required=false @type=url
POLAR_SUCCESS_URL=

# @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Upstash TCP endpoint in dev and production (D33); redis://redis:6379 in docker compose.
# @type=url
REDIS_URL=

# Sentry (D104). Empty turns error reporting off (local dev, CI).
# @public @required=false @type=url
SENTRY_DSN=

# dev or production; set by the ECS task definition.
# @public @required=false
SENTRY_ENVIRONMENT=

# Image tag (commit SHA); set by the ECS task definition.
# @public @required=false
SENTRY_RELEASE=
