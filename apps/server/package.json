{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test": "vitest run"
  },
  "dependencies": {
    "@Biz4kit/api": "workspace:*",
    "@Biz4kit/auth": "workspace:*",
    "@Biz4kit/db": "workspace:*",
    "@Biz4kit/monitoring": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@sentry/node": "11.9.0",
    "better-auth": "catalog:",
    "bullmq": "6.4.0",
    "evlog": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Biz4kit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "catalog:",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
