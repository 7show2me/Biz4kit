# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Sentry (D104). Empty turns error reporting off (local dev, CI). The DSN is
# public by design: it ships in the browser bundle.
# @public @required=false @type=url
VITE_SENTRY_DSN=

# dev, production or preview; set by Vercel per branch.
# @public @required=false
VITE_SENTRY_ENVIRONMENT=

# Commit SHA; set by the deploy workflow.
# @public @required=false
VITE_SENTRY_RELEASE=
