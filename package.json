{
  "name": "Biz4kit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @Biz4kit/db --",
    "db:studio": "turbo run db:studio -F @Biz4kit/db --",
    "db:generate": "turbo run db:generate -F @Biz4kit/db --",
    "db:migrate": "turbo run db:migrate -F @Biz4kit/db --",
    "deploy:setup": "pnpm dlx vercel link",
    "dev:vercel": "pnpm dlx vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "pnpm dlx vercel deploy",
    "deploy:prod": "pnpm dlx vercel deploy --prod",
    "deploy:check": "pnpm dlx vercel deploy --dry",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo run test",
    "test:infra": "terraform -chdir=infra init -backend=false -input=false && terraform -chdir=infra test && terraform -chdir=infra/bootstrap init -backend=false -input=false && terraform -chdir=infra/bootstrap test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Biz4kit/config": "workspace:*",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
